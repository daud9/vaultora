# Browser-side configuration only. VAULTORA is locked to Stellar Testnet.
# Never put secret keys or private credentials here.
# Supabase sync stays disabled until the private migration and Auth are configured.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set only after a genuine Testnet deployment; leave blank otherwise.
VITE_STELLAR_CONTRACT_ID=
# These defaults must match the deployed contract ABI.
VITE_STELLAR_REGISTER_METHOD=register_document
VITE_STELLAR_VERIFY_METHOD=verify_document

# Optional. This public WalletConnect app identifier enables compatible mobile wallets.
# Obtain the real project ID for VAULTORA; do not substitute a placeholder.
VITE_WALLETCONNECT_PROJECT_ID=
