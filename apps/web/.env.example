# Browser-side configuration only. VAULTORA is locked to Stellar Testnet.
# Never put secret keys or private credentials here.
# Supabase sync stays disabled until the private migration and Auth are configured.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set only after a genuine Testnet deployment; leave blank otherwise.
VITE_STELLAR_CONTRACT_ID=
# These defaults must match the deployed contract ABI.
VITE_STELLAR_REGISTER_METHOD=register_document
VITE_STELLAR_VERIFY_METHOD=verify_document

# Passkey smart-account wallet (Smart Account Kit 0.10.0, Stellar Testnet only).
# All values below are public contract addresses / hashes, not secrets.
# The defaults in apps/web/src/lib/passkeyWallet.ts are these verified
# stellar-accounts v0.8.0 Testnet values; set the variables only to override.
VITE_PASSKEY_ACCOUNT_WASM_HASH=c514d35ea67eaea9bfc1fb3327854c0c06111bc1ddebd4fe217c504c1004b9e1
VITE_PASSKEY_WEBAUTHN_VERIFIER=CC7EKIHQP3TN4CARQDND6CEOY2UXLWWC2X5GHTD5NLAT7BG5GPZIOM3F
VITE_PASSKEY_ED25519_VERIFIER=CAAVTMCBXEIBPR64EAASKFXERVPYFZA2JYP5A3BG6PESWEFUJX5IHKN4
VITE_PASSKEY_NATIVE_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
VITE_PASSKEY_THRESHOLD_POLICY=CAZ2WFUDXGX265LOEARFEOYYUL6F4BYWXZLGUAWZNJY3MRFPNLSZVS4S
VITE_PASSKEY_WEIGHTED_THRESHOLD_POLICY=CDBYLFLUNPAYGE3AHZSMB4TFWECFCCHX6CJFMFO6HRPKK2W5PFU2LCKE
VITE_PASSKEY_SPENDING_LIMIT_POLICY=CC3CEYQAP6NPNFIYSWL5MVZRCPJZGWX4XO7WDEJOUVGO2FZX5OONYPA5
# Self-hosted VAULTORA Testnet relayer (same origin, POST /api/relayer).
# The app defaults to "/api/relayer" when this is blank; set it only to
# point at a different relayer URL. Do NOT set it to the shared
# SDF-ecosystem proxy
# (https://smart-account-relayer-proxy.sdf-ecosystem.workers.dev): that
# proxy returns 403 "Origin is not allowed" for every browser origin
# (verified 2026-11-27), so no browser app can use it. See
# docs/PASSKEY_WALLET.md. No secret is stored in the bundle; the sponsor
# keypair lives only in the VAULTORA_RELAYER_SPONSOR_SECRET Vercel env var.
VITE_RELAYER_URL=
# Optional indexer override (Mercury Testnet is the kit default). Leave blank
# to use the kit default.
VITE_PASSKEY_INDEXER_URL=
# Stored passkey session lifetime in milliseconds (default: 7 days).
VITE_PASSKEY_SESSION_EXPIRY_MS=604800000
